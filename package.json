{
  "name": "minh-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Minh (明) — Bun trading agent. Public Bybit market cache + paper simulation (no keys, no real orders).",
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "query": "bun run src/feed/bb/query.ts",
    "backfill": "bun run src/feed/bb/backfill.ts",
    "brief": "bun run src/feed/bb/brief.ts",
    "paper": "bun run src/paper/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "typescript": "^7.0.2"
  }
}
