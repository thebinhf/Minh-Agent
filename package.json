{
  "name": "minh-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Minh (明) — Bun trading agent. Public Bybit market cache + paper simulation (no keys, no real orders).",
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "query": "bun run src/feed/bb/query.ts",
    "backfill": "bun run src/feed/bb/backfill.ts",
    "brief": "bun run src/feed/bb/brief.ts",
    "brief-pack": "bun run src/brief-pack.ts",
    "map": "bun run src/feed/bb/map.ts",
    "confirm": "bun run src/feed/bb/confirm.ts",
    "zones": "bun run src/feed/bb/zones.ts",
    "ta": "bun run src/ta/cli.ts",
    "paper": "bun run src/paper/cli.ts",
    "live": "bun run src/live/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "ci": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "typescript": "^7.0.2"
  }
}
