{
  "endpoint": "wss://stream.bybit.com/v5/public/linear",
  "restEndpoint": "https://api.bybit.com",
  "restFallbacks": ["https://api.manepa.jp"],
  "httpHost": "127.0.0.1",
  "httpPort": 43180,
  "dbPath": "./data/bybit-market.sqlite",
  "symbols": [
    "BTCUSDT",
    "ETHUSDT",
    "SOLUSDT",
    "ENAUSDT",
    "BNBUSDT",
    "XRPUSDT",
    "DOGEUSDT",
    "AVAXUSDT",
    "LINKUSDT"
  ],
  "klineIntervals": ["5", "15", "60", "240"],
  "orderbook": {
    "depth": 50,
    "symbols": ["BTCUSDT", "ETHUSDT", "SOLUSDT"]
  },
  "pingIntervalMs": 20000,
  "reconnect": {
    "initialDelayMs": 1000,
    "maxDelayMs": 30000
  },
  "retention": {
    "tickerSnapshotsHours": 24,
    "orderbookSnapshotsHours": 6,
    "klinesDays": 14,
    "pruneIntervalMs": 300000
  },
  "snapshot": {
    "tickerEveryMs": 0,
    "orderbookEveryMs": 5000
  },
  "recovery": {
    "pongStaleMs": 60000,
    "watchdogIntervalMs": 10000,
    "watchdogGraceMs": 30000,
    "subscribeChunkSize": 10,
    "subscribeRetries": 3,
    "subscribeRetryDelayMs": 1000,
    "subscribeAckTimeoutMs": 5000,
    "restRetries": 3,
    "restRetryDelayMs": 400,
    "restTimeoutMs": 10000,
    "gapFill": true,
    "klineLagMs": 180000
  }
}
