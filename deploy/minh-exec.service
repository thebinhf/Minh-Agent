[Unit]
Description=Minh Agent — exec process (Stage 2: testnet read-only skeleton)
Documentation=https://github.com/thebinhf/Minh-Agent/blob/main/docs/live-execution.md
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/minh-agent
ExecStart=/home/ubuntu/.bun/bin/bun run exec
# Auth rejection exits non-stop-loop: 5 failures in 10 min parks the unit.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=600
StartLimitBurst=5
Environment=EXEC_MODE=testnet
Environment=EXEC_HTTP_HOST=127.0.0.1
Environment=EXEC_HTTP_PORT=43183
Environment=EXEC_DB_PATH=/var/lib/bybit-ws-tracker/exec.sqlite
# Keys live in credential files, never Environment=. systemd maps each
# LoadCredential= source into $CREDENTIALS_DIRECTORY; exec reads
# bybit_api_key / bybit_api_secret from there and refuses plaintext key env.
LoadCredential=bybit_api_key:/etc/minh/exec/bybit_api_key
LoadCredential=bybit_api_secret:/etc/minh/exec/bybit_api_secret
# Read-only skeleton (Stage 2). Order placement is Stage 3 behind its own
# review. Deliberately NOT part of minh.target — exec is opt-in per process.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
