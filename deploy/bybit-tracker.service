[Unit]
Description=Minh Agent — Bybit public WebSocket market tracker (read-only, no keys)
Documentation=https://bybit-exchange.github.io/docs/v5/ws/connect
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Override User / WorkingDirectory / Environment via:
#   sudo systemctl edit bybit-tracker
User=ubuntu
WorkingDirectory=/opt/minh-agent
ExecStart=/home/ubuntu/.bun/bin/bun run start
Restart=always
RestartSec=3
Environment=BYBIT_HTTP_HOST=127.0.0.1
Environment=BYBIT_HTTP_PORT=43180
Environment=BYBIT_DB_PATH=/var/lib/bybit-ws-tracker/market.sqlite
Environment=PAPER_HTTP_HOST=127.0.0.1
Environment=PAPER_HTTP_PORT=43181
# 24/7: WS + paper tick + MAP dump on 1H/4H close. MAP_CLOSE=0 to disable dump.
# Optional MAP_CLOSE_WEBHOOK=https://…  (JSON map.close — not an order)
Environment=MAP_CLOSE=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
